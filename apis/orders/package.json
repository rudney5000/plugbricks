    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@apollo/subgraph": "2.15.1",
    "graphql": "16.14.2",
    "graphql-yoga": "6.0.1",
    "jose": "6.2.16",
    "pg": "8.23.1"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
