{
  "name": "plugbricks",
  // Official devcontainers TypeScript/Node image, Node 22, exact tag (no floating tags).
  "image": "mcr.microsoft.com/devcontainers/typescript-node:5.2.6-22-bookworm",

  "features": {
    // Lets scripts drive the host's Docker daemon.
    "ghcr.io/devcontainers/features/docker-outside-of-docker:1.10.2": {}
    // Score is not used (decision D5). k3d and kubectl are not installed here yet; they come with the Kubernetes end-to-end test.
  },

  "postCreateCommand": "npm ci",

  "customizations": {
    "vscode": {
      // No ESLint extension: the project has no ESLint config.
      // JSON Schema validation of plugin.json ("$schema") is built into VS Code.
      "extensions": []
    }
  }
}
