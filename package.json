{
  "name": "plugbricks-monorepo",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "workspaces": [
    "packages/plugbricks",
    "packages/create-plugbricks",
    "packages/admin"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:unit": "npm run test:unit --workspaces --if-present",
    "coverage": "npm run coverage --workspaces --if-present",
    "quality": "npm run format:check && npm run lint && npm run typecheck && npm test",
    "hooks:install": "git config core.hooksPath .githooks",
    "crosscheck:install": "npm ci --prefix tools/wgc-crosscheck",
    "pretest": "npm run build -w plugbricks-admin",
    "pretest:unit": "npm run build -w plugbricks-admin"
  },
  "overrides": {
    "@graphql-tools/utils": "12.1.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@vitest/coverage-v8": "5.1.1",
    "eslint": "10.15.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.14.0",
    "prettier": "3.10.1",
    "typescript-eslint": "8.73.0"
  }
}
