{
  "$schema": "https://raw.githubusercontent.com/rudney5000/plugbricks/main/packages/plugbricks/schemas/plugin-manifest.schema.json",
  "name": "orders-api",
  "version": "0.1.0",
  "description": "Your first service: a GraphQL subgraph that stores orders in a database. Replace the image with your own.",
  "services": [
    {
      "name": "app",
      "image": "ghcr.io/example/orders-api-app:0.1.0",
      "port": 4000,
      "healthcheck": {
        "exec": [
          "wget",
          "-qO-",
          "http://localhost:4000/health"
        ]
      }
    }
  ],
  "requires": {
    "database": {
      "wait": "healthy",
      "timeoutSeconds": 120
    }
  },
  "subgraph": {
    "service": "app",
    "schema": "schema.graphql",
    "path": "/graphql"
  }
}
