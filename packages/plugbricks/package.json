{
  "name": "plugbricks",
  "version": "0.0.1",
  "description": "Add plugins and infrastructure bricks to a federated GraphQL project, on Docker Compose or Kubernetes, from one manifest.",
  "type": "module",
  "license": "UNLICENSED",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./schema.json": "./schemas/plugin-manifest.schema.json",
    "./package.json": "./package.json"
  },
  "bin": {
    "plugbricks": "dist/bin.js"
  },
  "files": [
    "dist",
    "schemas"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepack": "npm run build",
    "test": "vitest run",
    "test:unit": "vitest run --exclude \"**/e2e-*.test.ts\" --exclude \"**/node_modules/**\"",
    "coverage": "vitest run --exclude \"**/e2e-*.test.ts\" --exclude \"**/node_modules/**\" --coverage --coverage.provider=v8 --coverage.reporter=text-summary --coverage.reporter=lcov",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@bufbuild/protobuf": "2.17.0",
    "@graphql-tools/utils": "12.1.0",
    "@wundergraph/composition": "0.68.1",
    "@wundergraph/cosmo-connect": "0.164.0",
    "@wundergraph/cosmo-shared": "0.50.1",
    "ajv": "8.20.0",
    "graphql": "16.14.2",
    "openid-client": "6.9.0"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "typescript": "5.9.3",
    "vitest": "2.1.9"
  }
}
