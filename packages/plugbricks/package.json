{
  "name": "plugbricks",
  "version": "0.0.1",
  "description": "Add plugins and infrastructure bricks to a federated GraphQL project, on Docker Compose or Kubernetes, from one manifest.",
  "type": "module",
  "license": "UNLICENSED",
  "private": true,
  "engines": { "node": ">=20" },
  "exports": {
    ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" },
    "./schema.json": "./schemas/plugin-manifest.schema.json"
  },
  "files": ["dist", "schemas"],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepack": "npm run build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "ajv": "8.20.0"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "typescript": "5.9.3",
    "vitest": "2.1.9"
  }
}
