{
  "name": "plugbricks",
  "version": "0.1.0",
  "description": "Add plugins and infrastructure bricks to a federated GraphQL project, on Docker Compose or Kubernetes, from one manifest.",
  "type": "module",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rudney5000/plugbricks.git",
    "directory": "packages/plugbricks"
  },
  "homepage": "https://github.com/rudney5000/plugbricks#readme",
  "bugs": {
    "url": "https://github.com/rudney5000/plugbricks/issues"
  },
  "keywords": [
    "graphql",
    "federation",
    "apollo-federation",
    "cosmo",
    "docker-compose",
    "kubernetes",
    "platform",
    "plugins"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./schema.json": "./schemas/plugin-manifest.schema.json",
    "./package.json": "./package.json"
  },
  "bin": {
    "plugbricks": "dist/bin.js"
  },
  "files": [
    "dist",
    "schemas",
    "templates",
    "NOTICE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepack": "npm run build && node scripts/copy-admin-ui.mjs",
    "test": "vitest run",
    "test:unit": "vitest run --exclude \"**/e2e-*.test.ts\" --exclude \"**/node_modules/**\"",
    "coverage": "vitest run --exclude \"**/e2e-*.test.ts\" --exclude \"**/node_modules/**\" --coverage --coverage.provider=v8 --coverage.reporter=text-summary --coverage.reporter=lcov",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@bufbuild/protobuf": "2.17.0",
    "@graphql-tools/utils": "12.1.0",
    "@wundergraph/composition": "0.68.2",
    "@wundergraph/cosmo-connect": "0.165.0",
    "@wundergraph/cosmo-shared": "0.50.2",
    "ajv": "8.20.0",
    "graphql": "16.15.0",
    "openid-client": "6.9.1"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "typescript": "7.0.2",
    "vitest": "5.1.1"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
