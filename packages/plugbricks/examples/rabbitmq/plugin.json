{
  "$schema": "../../schemas/plugin-manifest.schema.json",
  "name": "rabbitmq",
  "version": "0.1.0",
  "description": "Base brick: a RabbitMQ broker that provides the \"queue\" capability to every consumer that requires it. One broker is shared by all of them; each consumer gets AMQP_URL and its own QUEUE_NAME. The account is shared by design for now (D11): per-consumer accounts need the management port, which a brick cannot expose yet.",
  "services": [
    {
      "name": "broker",
      "image": "rabbitmq:4.1.4-management",
      "port": 5672,
      "volumes": [
        {
          "name": "data",
          "mountPath": "/var/lib/rabbitmq",
          "retention": "retain"
        }
      ],
      "healthcheck": {
        "exec": ["rabbitmq-diagnostics", "-q", "ping"],
        "intervalSeconds": 10,
        "timeoutSeconds": 5,
        "retries": 10,
        "startPeriodSeconds": 20
      },
      "env": {
        "RABBITMQ_DEFAULT_USER": "plugbricks",
        "RABBITMQ_DEFAULT_PASS": "${secrets.default_password}"
      }
    }
  ],
  "provides": {
    "queue": {
      "service": "broker",
      "ready": {
        "exec": ["nc", "-z", "-w", "2", "${provider.host}", "${provider.port}"],
        "image": "busybox:1.36",
        "intervalSeconds": 2
      },
      "provision": {
        "image": "busybox:1.36",
        "command": ["true"]
      },
      "inject": {
        "AMQP_URL": "amqp://plugbricks:${secrets.default_password}@${provider.host}:${provider.port}/",
        "QUEUE_NAME": "${consumer.name}"
      }
    }
  }
}
