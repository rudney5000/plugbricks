# Image of {{name}}. Build it from the project folder (the schema comes from the brick):
#   docker build -t {{image}} -f services/{{name}}/Dockerfile .
FROM golang:1.27.4-alpine AS build
WORKDIR /app
# go.sum holds the checksum of every module: the download is verified against it.
COPY services/{{name}}/go.mod services/{{name}}/go.sum ./
RUN go mod download
COPY services/{{name}}/ ./
COPY bricks/{{name}}/schema.graphql ./
# gqlgen writes the Go code of the schema, then the service is compiled to one static binary.
RUN go tool gqlgen generate && CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /service .

FROM alpine:3.24.4
ENV PORT=4000
COPY --from=build /service /service
# Never root at run time. wget (busybox) stays available for the brick's health check.
USER nobody
EXPOSE 4000
CMD ["/service"]
