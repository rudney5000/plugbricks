// {{name}}: a GraphQL subgraph, created by "plugbricks create". Its schema is bricks/{{name}}/schema.graphql, the one
// the platform composes; the image carries a copy of it (see the Dockerfile). Replace the items below with your own data.
import { readFileSync } from "node:fs";
import { createServer } from "node:http";
import { buildSubgraphSchema } from "@apollo/subgraph";
import { parse } from "graphql";
import { createYoga } from "graphql-yoga";
import { tokenCheckFromEnv, type Caller } from "./auth.js";

interface {{Type}} {
  id: string;
  name: string;
}

const items: {{Type}}[] = [
  { id: "1", name: "first" },
  { id: "2", name: "second" },
];

const typeDefs = parse(readFileSync(new URL("../schema.graphql", import.meta.url), "utf8"));
const resolvers = {
  Query: {
    {{field}}: () => items,
  },
  {{Type}}: {
    // Called by the router when another subgraph refers to an item by its key.
    __resolveReference: (ref: { id: string }) => items.find((i) => i.id === ref.id) ?? null,
  },
};

// With the platform's oidc provider (OIDC_* set): no valid token, no GraphQL, even past the router. See auth.ts.
const checkToken = (() => {
  try {
    return tokenCheckFromEnv(process.env);
  } catch (e) {
    console.error(`{{name}}: ${(e as Error).message}`);
    process.exit(1);
  }
})();
if (checkToken) console.log(`{{name}}: requests need a token from ${process.env.OIDC_ISSUER}`);

// A resolver finds the caller in its context (the third argument): `context.caller`, undefined without a token check.
const yoga = createYoga<{ caller?: Caller }>({ schema: buildSubgraphSchema([{ typeDefs, resolvers }]), graphiql: false, landingPage: false });

const server = createServer((req, res) => {
  if (req.url === "/health") {
    res.writeHead(200, { "content-type": "text/plain" }).end("ok");
    return;
  }
  if (!checkToken) return yoga(req, res);
  void checkToken(req.headers.authorization).then((caller) => {
    if (!caller) {
      res
        .writeHead(401, { "content-type": "application/json", "www-authenticate": 'Bearer realm="plugbricks"' })
        .end(JSON.stringify({ errors: [{ message: "unauthorized" }] }));
      return;
    }
    void yoga(req, res, { caller });
  });
});

const port = Number(process.env.PORT ?? 4000);
server.listen(port, () => console.log(`{{name}}: listening on :${port} (/graphql, /health)`));
for (const signal of ["SIGTERM", "SIGINT"] as const) process.on(signal, () => server.close(() => process.exit(0)));
