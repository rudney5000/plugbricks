# Image of {{name}}. Build it from the project folder (the schema comes from the brick):
#   docker build -t {{image}} -f services/{{name}}/Dockerfile .
FROM node:22.23.5-alpine AS build
WORKDIR /app
COPY services/{{name}}/package.json services/{{name}}/package-lock.json ./
RUN npm ci --no-audit --no-fund
COPY services/{{name}}/tsconfig.json ./
COPY services/{{name}}/src ./src
RUN npm run build

FROM node:22.23.5-alpine
ENV NODE_ENV=production PORT=4000
WORKDIR /app
COPY services/{{name}}/package.json services/{{name}}/package-lock.json ./
RUN npm ci --omit=dev --no-audit --no-fund && npm cache clean --force
COPY --from=build /app/dist ./dist
COPY bricks/{{name}}/schema.graphql ./
# Never root at run time. wget (busybox) stays available for the brick's health check.
USER node
EXPOSE 4000
CMD ["node", "dist/main.js"]
