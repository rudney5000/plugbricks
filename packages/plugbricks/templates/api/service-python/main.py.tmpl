"""{{name}}: a GraphQL subgraph in Python, created by "plugbricks create".

Its schema is bricks/{{name}}/schema.graphql, the one the platform composes; the image carries a copy of it (see the
Dockerfile). Replace the items below with your own data.
"""

import asyncio
import os
import sys
from pathlib import Path

import uvicorn
from ariadne import QueryType, format_error
from ariadne.asgi import GraphQL
from ariadne.asgi.handlers import GraphQLHTTPHandler
from ariadne.contrib.federation import FederatedObjectType, make_federated_schema
from ariadne.explorer import ExplorerHttp405
from graphql import GraphQLError

from auth import authorization_from_env, field_rules_middleware, forbidden_message, may_run, token_check_from_env

ITEMS = [{"id": "1", "name": "first"}, {"id": "2", "name": "second"}]

query = QueryType()
item = FederatedObjectType("{{Type}}")


@query.field("{{field}}")
def resolve_items(*_):
    return ITEMS


@item.reference_resolver
def resolve_reference(_, _info, representation):
    # Called by the router when another subgraph refers to an item by its key.
    return next((i for i in ITEMS if i["id"] == representation["id"]), None)


def format_masked(error, debug=False):
    """Raise a GraphQLError to tell the caller something; the message of any other exception stays in the log."""
    original = error.original_error
    if original is not None and not isinstance(original, GraphQLError):
        return {"message": "Unexpected error.", "path": error.path}
    return format_error(error, debug)


schema = make_federated_schema((Path(__file__).parent / "schema.graphql").read_text(), query, item)

# With the platform's oidc provider (OIDC_* set): no valid token, no GraphQL, even past the router. See auth.py.
try:
    check_token = token_check_from_env(os.environ)
except ValueError as e:
    print(f"{{name}}: {e}", file=sys.stderr, flush=True)
    sys.exit(1)
if check_token:
    print(f"{{name}}: requests need a token from {os.environ['OIDC_ISSUER']}", flush=True)


# With roles (the manifest's "authorization" block, D22): an operation whose class the token has no role for stops before
# any resolver runs. See auth.py.
try:
    authorization = authorization_from_env(os.environ)
except ValueError as e:
    print(f"{{name}}: {e}", file=sys.stderr, flush=True)
    sys.exit(1)


def authorize(next_, obj, info, **kwargs):
    """Middleware: each root field of the operation passes only for a caller whose token has the role of its class."""
    if info.path.prev is None:
        caller = info.context["caller"]
        operation = info.operation.operation.value
        if caller is None or not may_run(caller, authorization, operation):
            # The HTTP status is 403, as the examples: the answer is rewritten in app() once the flag is set.
            info.context["request"].scope["forbidden"] = True
            raise GraphQLError(forbidden_message(authorization, operation), extensions={"code": "FORBIDDEN"})
    return next_(obj, info, **kwargs)


def context_value(request, _data):
    """A resolver finds the caller in its context: info.context["caller"], None without a token check."""
    return {"request": request, "caller": request.scope.get("caller")}


graphql = GraphQL(
    schema,
    context_value=context_value,
    explorer=ExplorerHttp405(),
    error_formatter=format_masked,
    # The rules of the schema (@authenticated, @requiresScopes) apply to every call, the router's or a direct one. See auth.py.
    http_handler=GraphQLHTTPHandler(middleware=[*([authorize] if authorization else []), field_rules_middleware(schema)]),
)


async def app(scope, receive, send):
    """GraphQL on /graphql, and /health, which the brick's health check calls. Nothing else is served."""
    if scope["type"] != "http":
        return
    if scope["path"] == "/graphql":
        if check_token:
            header = next((v.decode("latin-1") for k, v in scope["headers"] if k == b"authorization"), None)
            # The keys are fetched over the network, which blocks: off the event loop.
            caller = await asyncio.to_thread(check_token, header)
            if caller is None:
                body = b'{"errors":[{"message":"unauthorized"}]}'
                headers = [(b"content-type", b"application/json"), (b"www-authenticate", b'Bearer realm="plugbricks"')]
                await send({"type": "http.response.start", "status": 401, "headers": headers})
                await send({"type": "http.response.body", "body": body})
                return
            scope["caller"] = caller

        async def answer(message):
            # A refused operation answers 403 (the token is valid, the caller is not allowed), whatever status ariadne chose
            # for a result with no data (it says 400).
            if message["type"] == "http.response.start" and scope.get("forbidden"):
                message = {**message, "status": 403}
            elif message["type"] == "http.response.start" and scope.get("refused_field") and message["status"] == 400:
                message = {**message, "status": 200}
            await send(message)

        await graphql(scope, receive, answer)
        return
    status, body = (200, b"ok\n") if scope["path"] == "/health" else (404, b"not found\n")
    await send({"type": "http.response.start", "status": status, "headers": [(b"content-type", b"text/plain")]})
    await send({"type": "http.response.body", "body": body})


if __name__ == "__main__":
    port = int(os.environ.get("PORT", "4000"))
    print(f"{{name}}: listening on :{port} (/graphql, /health)", flush=True)
    # uvicorn stops on SIGTERM (docker stop, Kubernetes) once the requests in flight are answered.
    uvicorn.run(app, host="0.0.0.0", port=port, lifespan="off", access_log=False, log_level="warning")
