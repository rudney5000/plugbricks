# Image of {{name}}. Build it from the project folder:
#   docker build -t {{image}} -f services/{{name}}/Dockerfile .
FROM node:22.23.5-alpine
ENV NODE_ENV=production PORT=3000
WORKDIR /app
COPY services/{{name}}/server.mjs ./
# Never root at run time. wget (busybox) stays available for the brick's health check.
USER node
EXPOSE 3000
CMD ["node", "server.mjs"]
