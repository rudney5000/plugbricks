{
  "$schema": "../../schemas/plugin-manifest.schema.json",
  "name": "open-api",
  "version": "0.1.0",
  "description": "A GraphQL API that requires oidc and says nothing about who may call it.",
  "services": [
    {
      "name": "app",
      "image": "ghcr.io/example/open-api:0.1.0",
      "port": 4000,
      "healthcheck": {
        "exec": [
          "wget",
          "-qO-",
          "http://localhost:4000/health"
        ]
      }
    }
  ],
  "requires": {
    "database": {
      "wait": "healthy",
      "timeoutSeconds": 120
    },
    "oidc": {
      "optional": true,
      "timeoutSeconds": 300
    }
  },
  "subgraph": {
    "service": "app",
    "schema": "schema.graphql",
    "path": "/graphql"
  },
  "tags": [
    "api",
    "graphql"
  ]
}
