{
  "name": "catalog",
  "version": "0.1.0",
  "description": "A subgraph that needs no capability: only the router waits for the oidc provider.",
  "services": [
    {
      "name": "app",
      "image": "plugbricks-example/orders-api:0.1.0",
      "port": 4000,
      "healthcheck": {
        "exec": ["wget", "-qO-", "http://localhost:4000/health"]
      }
    }
  ],
  "subgraph": {
    "service": "app",
    "schema": "schema.graphql",
    "path": "/graphql"
  },
  "tags": ["api", "graphql"]
}
