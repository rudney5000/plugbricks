{
  "description": "switching from one brick set to another leaves no stale file in .generated/<runtime>/",
  "steps": [
    {
      "run": [
        "init",
        "--name",
        "demo"
      ]
    },
    {
      "mutate": {
        "writeText": {
          "file": ".generated/compose/old.yaml",
          "text": "stale\n"
        }
      }
    },
    {
      "run": [
        "generate"
      ]
    }
  ],
  "absent": [
    ".generated/compose/old.yaml"
  ],
  "exists": [
    ".generated/compose/compose.yaml"
  ]
}
