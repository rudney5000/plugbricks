{
  "description": "a wait init container that exited 124 is reported as WAIT_TIMEOUT",
  "steps": [
    {
      "run": [
        "init",
        "--name",
        "demo"
      ]
    },
    {
      "run": [
        "add",
        "examples/postgres"
      ]
    },
    {
      "run": [
        "add",
        "examples/orders"
      ]
    },
    {
      "run": [
        "up",
        "--runtime",
        "k8s"
      ],
      "exit": 1,
      "codes": [
        "WAIT_TIMEOUT"
      ],
      "fake": [
        {
          "match": "rollout status deployment/orders-app",
          "status": 1,
          "stderr": "error: timed out waiting for the condition"
        },
        {
          "match": "get pods",
          "stdout": "{\"items\": [{\"status\": {\"initContainerStatuses\": [{\"name\": \"wait-database\", \"state\": {\"waiting\": {\"reason\": \"CrashLoopBackOff\"}}, \"lastState\": {\"terminated\": {\"exitCode\": 124}}}]}}]}"
        }
      ]
    }
  ]
}
