{
  "description": "up keeps a volume pending deletion until --prune-volumes, which deletes exactly that volume and updates the lock",
  "steps": [
    {
      "run": [
        "init",
        "--name",
        "demo"
      ]
    },
    {
      "run": [
        "add",
        "bricks/cache"
      ]
    },
    {
      "run": [
        "remove",
        "cache"
      ]
    },
    {
      "run": [
        "up"
      ],
      "stdout": "Pending deletion, kept until \"plugbricks up --prune-volumes\": cache/redis/data",
      "commands": [
        "docker compose version",
        "docker compose --project-name demo down --remove-orphans"
      ]
    },
    {
      "run": [
        "up",
        "--prune-volumes"
      ],
      "stdout": "deleted volume cache/redis/data",
      "commands": [
        "docker compose version",
        "docker compose --project-name demo down --remove-orphans",
        "docker volume rm demo_cache-redis-data"
      ]
    }
  ],
  "expectPrune": []
}
