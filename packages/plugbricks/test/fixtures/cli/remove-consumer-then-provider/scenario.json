{
  "description": "remove in dependency order: orders-api, then postgres",
  "steps": [
    {
      "run": [
        "init",
        "--name",
        "demo"
      ]
    },
    {
      "run": [
        "add",
        "examples/postgres"
      ]
    },
    {
      "run": [
        "add",
        "examples/orders-api"
      ]
    },
    {
      "run": [
        "remove",
        "orders-api"
      ]
    },
    {
      "run": [
        "remove",
        "postgres"
      ]
    }
  ],
  "absent": [
    ".platform/bricks/orders-api",
    ".platform/bricks/postgres"
  ]
}
