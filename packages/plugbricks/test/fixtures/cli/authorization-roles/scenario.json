{
  "description": "orders-api and shipping-api declare the roles of their queries and mutations (D22): with keycloak, each API gets them in its env and its provision task creates them on its own client, and orders-web, which lists orders-api and shipping-api, is granted their read roles and nothing more",
  "steps": [
    {
      "run": [
        "init",
        "--name",
        "demo"
      ]
    },
    {
      "run": [
        "add",
        "examples/postgres"
      ]
    },
    {
      "run": [
        "add",
        "examples/keycloak"
      ]
    },
    {
      "run": [
        "add",
        "examples/orders-api"
      ]
    },
    {
      "run": [
        "add",
        "examples/shipping-api"
      ]
    },
    {
      "run": [
        "add",
        "examples/orders-web"
      ]
    },
    {
      "run": [
        "generate"
      ]
    },
    {
      "run": [
        "generate",
        "--runtime",
        "k8s"
      ]
    }
  ],
  "expectRaw": {
    ".generated/compose/compose.yaml": "      AUTHORIZATION_MUTATIONS_ROLE: orders:write\n      AUTHORIZATION_QUERIES_ROLE: orders:read\n"
  }
}
