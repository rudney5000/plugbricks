{
  "description": "on Kubernetes, --prune-volumes deletes the PersistentVolumeClaim of the pending volume only",
  "steps": [
    {
      "run": [
        "init",
        "--name",
        "demo"
      ]
    },
    {
      "run": [
        "add",
        "bricks/cache"
      ]
    },
    {
      "run": [
        "remove",
        "cache"
      ]
    },
    {
      "run": [
        "up",
        "--runtime",
        "k8s",
        "--context",
        "test-cluster",
        "--prune-volumes"
      ],
      "commands": [
        "kubectl --context test-cluster version --client",
        "kubectl --context test-cluster apply --filename .generated/k8s/namespace.yaml",
        "kubectl --context test-cluster apply --filename .secrets/k8s-secret.yaml",
        "kubectl --context test-cluster --namespace demo delete deployment,service,configmap --selector app.kubernetes.io/managed-by=plugbricks,plugbricks/brick --ignore-not-found",
        "kubectl --context test-cluster --namespace demo delete persistentvolumeclaim cache-redis-data --ignore-not-found"
      ]
    }
  ],
  "expectPrune": []
}
