{
  "description": "enabling a brick again brings its services and subgraph back, and the lock returns to what it was",
  "steps": [
    { "run": ["init", "--name", "demo"] },
    { "run": ["add", "examples/postgres"] },
    { "run": ["add", "examples/orders-api"] },
    { "run": ["disable", "orders-api"] },
    { "run": ["enable", "orders-api"], "stdout": "Enabled orders-api" },
    { "run": ["generate"] }
  ],
  "exists": [".generated/compose/compose.yaml"]
}
