{
  "description": "orders-web lists shipping-api as an optional dependency (D22): adding it without shipping-api prints no warning, and shipping-api can then be disabled and removed while orders-web stays installed; the required one, orders-api, is still protected",
  "steps": [
    {
      "run": [
        "init",
        "--name",
        "demo"
      ]
    },
    {
      "run": [
        "add",
        "examples/postgres"
      ]
    },
    {
      "run": [
        "add",
        "examples/orders-api"
      ]
    },
    {
      "run": [
        "add",
        "examples/orders-web"
      ],
      "notStdout": "is not installed"
    },
    {
      "run": [
        "add",
        "examples/shipping-api"
      ]
    },
    {
      "run": [
        "disable",
        "shipping-api"
      ]
    },
    {
      "run": [
        "enable",
        "shipping-api"
      ]
    },
    {
      "run": [
        "remove",
        "shipping-api"
      ]
    },
    {
      "run": [
        "remove",
        "orders-api"
      ],
      "exit": 1,
      "codes": [
        "DEPENDENCY_IN_USE"
      ],
      "unchanged": true,
      "stderr": "\"orders-web\" declare it in \"dependencies\""
    }
  ],
  "absent": [
    ".platform/bricks/shipping-api"
  ]
}
