{
  "description": "up --runtime k8s applies namespace, Secret and resources, deletes what removed bricks left, and waits for each Deployment",
  "steps": [
    {
      "run": [
        "init",
        "--name",
        "demo"
      ]
    },
    {
      "run": [
        "add",
        "examples/postgres"
      ]
    },
    {
      "run": [
        "add",
        "examples/orders"
      ]
    },
    {
      "run": [
        "up",
        "--runtime",
        "k8s"
      ],
      "commands": [
        "kubectl version --client",
        "kubectl apply --filename .generated/k8s/namespace.yaml",
        "kubectl apply --filename .secrets/k8s-secret.yaml",
        "kubectl apply --filename .generated/k8s/resources.yaml",
        "kubectl --namespace demo delete deployment,service,configmap --selector app.kubernetes.io/managed-by=plugbricks,plugbricks/brick,plugbricks/brick notin (orders,postgres) --ignore-not-found",
        "kubectl --namespace demo rollout status deployment/orders-app --timeout=420s",
        "kubectl --namespace demo rollout status deployment/postgres-db --timeout=300s"
      ]
    }
  ]
}
