{
  "description": "--runtime, --context and --prune-volumes are checked before anything runs",
  "steps": [
    {
      "run": [
        "init",
        "--name",
        "demo"
      ]
    },
    {
      "run": [
        "generate",
        "--runtime",
        "swarm"
      ],
      "exit": 2,
      "codes": [
        "USAGE_INVALID_OPTION"
      ],
      "unchanged": true
    },
    {
      "run": [
        "generate",
        "--prune-volumes"
      ],
      "exit": 2,
      "codes": [
        "USAGE_INVALID_OPTION"
      ],
      "unchanged": true
    },
    {
      "run": [
        "status",
        "--runtime",
        "k8s"
      ],
      "exit": 1,
      "codes": [
        "K8S_CONTEXT_REQUIRED"
      ],
      "unchanged": true
    },
    {
      "run": [
        "up",
        "extra"
      ],
      "exit": 2,
      "codes": [
        "USAGE_UNEXPECTED_ARGUMENT"
      ],
      "unchanged": true
    },
    {
      "run": [
        "up",
        "--context",
        "x"
      ],
      "exit": 2,
      "codes": [
        "USAGE_INVALID_OPTION"
      ],
      "unchanged": true
    },
    {
      "run": [
        "down",
        "--kubeconfig",
        "k.yaml"
      ],
      "exit": 2,
      "codes": [
        "USAGE_INVALID_OPTION"
      ],
      "unchanged": true
    },
    {
      "run": [
        "up",
        "--runtime",
        "k8s",
        "--allow-context",
        "x"
      ],
      "exit": 2,
      "codes": [
        "USAGE_INVALID_OPTION"
      ],
      "unchanged": true
    },
    {
      "run": [
        "status",
        "--context",
        "x"
      ],
      "exit": 2,
      "codes": [
        "USAGE_INVALID_OPTION"
      ],
      "unchanged": true
    }
  ]
}
