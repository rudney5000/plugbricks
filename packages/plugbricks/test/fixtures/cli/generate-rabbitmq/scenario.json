{
  "description": "a RabbitMQ broker provides queue to a consumer: its own vhost, user and password in AMQP_URL, QUEUE_NAME, the broker's data volume kept, the management port in its Service",
  "steps": [
    {
      "run": ["init", "--name", "queue-demo"]
    },
    {
      "run": ["add", "examples/rabbitmq"],
      "stdout": "Added rabbitmq 0.1.0"
    },
    {
      "run": ["add", "bricks/consumer"],
      "stdout": "Added consumer 0.1.0"
    },
    {
      "run": ["generate"],
      "stdout": "Created 2 secret(s) in .secrets/: PB_RABBITMQ__CONSUMER__CONSUMER_PASSWORD, PB_RABBITMQ__DEFAULT_PASSWORD"
    },
    {
      "run": ["generate", "--runtime", "k8s"]
    }
  ],
  "exists": [
    ".generated/compose/compose.yaml",
    ".generated/k8s/resources.yaml",
    ".secrets/secrets.env"
  ]
}
