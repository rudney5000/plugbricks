{
  "description": "the real example bricks: shipping-api is refused while orders-api is not installed, then orders-api and shipping-api are added; removing orders-api while shipping-api extends it is refused",
  "steps": [
    {
      "run": [
        "init",
        "--name",
        "demo"
      ]
    },
    {
      "run": [
        "add",
        "examples/postgres"
      ]
    },
    {
      "run": [
        "add",
        "examples/shipping-api"
      ],
      "exit": 1,
      "codes": [
        "EXTENDS_OWNER_MISSING"
      ],
      "stderr": "extends entity \"Order\" of brick \"orders-api\", which is not installed; add \"orders-api\" first",
      "unchanged": true
    },
    {
      "run": [
        "add",
        "examples/orders-api"
      ]
    },
    {
      "run": [
        "add",
        "examples/shipping-api"
      ]
    },
    {
      "run": [
        "status"
      ],
      "stdout": "Federation: orders-api, shipping-api; composed with @wundergraph/composition 0.68.2"
    },
    {
      "run": [
        "remove",
        "orders-api"
      ],
      "exit": 1,
      "codes": [
        "EXTENDS_IN_USE"
      ],
      "stderr": "its entities are still extended by \"shipping-api\"",
      "unchanged": true
    }
  ]
}
